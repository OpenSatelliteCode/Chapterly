<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chapterly — @<%= profileUser.username %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>

  <div class="profile-header">
    <% if (profileUser.avatar_url) { %>
      <img src="<%= profileUser.avatar_url %>" alt="@<%= profileUser.username %>" class="avatar-big" style="object-fit: cover;">
    <% } else { %>
      <div class="avatar-big"><%= profileUser.username.charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <h1>@<%= profileUser.username %></h1>
      <% if (profileUser.bio) { %><div class="bio"><%= profileUser.bio %></div><% } %>
      <% if (currentUser && currentUser.id === profileUser.id) { %>
        <a href="/settings" class="btn-outline" style="display:inline-block; margin-top:12px; padding: 8px 18px;">Editar perfil</a>
      <% } %>
    </div>
  </div>

  <div class="section-label">
    <h2>Libros publicados (<%= books.length %>)</h2>
  </div>

  <% if (books.length === 0) { %>
    <div class="empty-state">Este usuario todavía no ha publicado nada.</div>
  <% } else { %>
    <div class="grid">
      <% books.forEach(function(book) { %>
        <div class="book">
          <a href="/book/<%= book.id %>" class="cover" style="text-decoration:none; color:inherit;">
            <div class="cat-tag"><%= book.category_name || 'Sin categoría' %></div>
            <div class="cover-title"><%= book.title %></div>
          </a>
          <a href="/book/<%= book.id %>" class="book-meta" style="text-decoration:none; color:inherit;">
            <div class="title"><%= book.title %></div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>

  <%- include('partials/footer') %>
</body>
</html>
